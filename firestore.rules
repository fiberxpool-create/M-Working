rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Candidate profiles — doc ID = the user's own uid
    match /candidates/{uid} {
      allow read: if request.auth != null;                       // any logged-in user can see the pool
      allow write: if request.auth != null && request.auth.uid == uid;  // only you can edit your own profile
    }

    // Job postings
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.postedByUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.postedByUid == request.auth.uid;
    }
  }
}
